<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- ============================================================= -->
    <!-- Sequences                                                     -->
    <!-- ============================================================= -->
    <changeSet id="001-create-sequences" author="copilot">
        <createSequence sequenceName="seq_customer_id" startValue="1000" incrementBy="1"/>
        <createSequence sequenceName="seq_address_id" startValue="10000" incrementBy="1"/>
        <createSequence sequenceName="seq_product_id" startValue="20000" incrementBy="1"/>
        <createSequence sequenceName="seq_orders_id" startValue="30000" incrementBy="1"/>
        <createSequence sequenceName="seq_orders_detail_id" startValue="30000" incrementBy="1"/>
        <createSequence sequenceName="seq_payment_id" startValue="40000" incrementBy="1"/>
        <createSequence sequenceName="seq_refund_id" startValue="45000" incrementBy="1"/>
        <createSequence sequenceName="seq_shipment_id" startValue="50000" incrementBy="1"/>
    </changeSet>

    <!-- ============================================================= -->
    <!-- Master Data: customers, addresses, products, inventory        -->
    <!-- ============================================================= -->
    <changeSet id="010-create-customers" author="copilot">
        <createTable tableName="customers">
            <column name="customer_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_customers" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(160)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_customers_email"/>
            </column>
            <column name="first_name" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(32)"/>
            <column name="status" type="VARCHAR(16)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_customers_name" tableName="customers">
            <column name="last_name"/>
            <column name="first_name"/>
        </createIndex>
    </changeSet>

    <changeSet id="020-create-addresses" author="copilot">
        <createTable tableName="addresses">
            <column name="address_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_addresses" nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT"/>
            <column name="address_label" type="VARCHAR(40)"/>
            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(32)"/>
            <column name="email" type="VARCHAR(120)"/>
            <column name="line1" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="line2" type="VARCHAR(200)"/>
            <column name="city" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="VARCHAR(120)"/>
            <column name="postal_code" type="VARCHAR(32)"/>
            <column name="country_code" type="VARCHAR(2)" defaultValue="US">
                <constraints nullable="false"/>
            </column>
            <column name="created_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="addresses" baseColumnNames="customer_id"
                referencedTableName="customers" referencedColumnNames="customer_id"
                constraintName="fk_addresses_customer"
                onDelete="SET NULL" onUpdate="RESTRICT"/>
        <createIndex indexName="idx_addresses_customer" tableName="addresses">
            <column name="customer_id"/>
        </createIndex>
        <createIndex indexName="idx_addresses_label" tableName="addresses">
            <column name="address_label"/>
        </createIndex>
    </changeSet>

    <changeSet id="030-create-products" author="copilot">
        <createTable tableName="products">
            <column name="product_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_products" nullable="false"/>
            </column>
            <column name="sku" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_products_sku"/>
            </column>
            <column name="name" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(2000)"/>
            <column name="price" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="weight_grams" type="INT"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_products_name" tableName="products">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="040-create-inventory" author="copilot">
        <createTable tableName="product_inventory">
            <column name="product_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_product_inventory" nullable="false"/>
            </column>
            <column name="quantity_on_hand" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_reserved" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="product_inventory" baseColumnNames="product_id"
                referencedTableName="products" referencedColumnNames="product_id"
                constraintName="fk_inventory_product"
                onDelete="CASCADE" onUpdate="RESTRICT"/>
    </changeSet>

    <!-- ============================================================= -->
    <!-- Orders, Details, Payments, Refunds, Shipments                 -->
    <!-- ============================================================= -->
    <changeSet id="100-create-orders" author="copilot">
        <createTable tableName="orders">
            <column name="order_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_orders" nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="order_number" type="VARCHAR(30)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_orders_order_number"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="subtotal_amount" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="discount_amount" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tax_amount" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="shipping_amount" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="billing_address_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="shipping_address_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="placed_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="paid_at_utc" type="TIMESTAMP"/>
            <column name="updated_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="orders" baseColumnNames="customer_id"
                referencedTableName="customers" referencedColumnNames="customer_id"
                constraintName="fk_orders_customer"
                onDelete="RESTRICT" onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="orders" baseColumnNames="billing_address_id"
                referencedTableName="addresses" referencedColumnNames="address_id"
                constraintName="fk_orders_billing_addr"
                onDelete="RESTRICT" onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="orders" baseColumnNames="shipping_address_id"
                referencedTableName="addresses" referencedColumnNames="address_id"
                constraintName="fk_orders_shipping_addr"
                onDelete="RESTRICT" onUpdate="RESTRICT"/>
        <createIndex indexName="idx_orders_customer" tableName="orders">
            <column name="customer_id"/>
        </createIndex>
        <createIndex indexName="idx_orders_status" tableName="orders">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_orders_placed" tableName="orders">
            <column name="placed_at_utc"/>
        </createIndex>
    </changeSet>


    <!-- 110 - ORDER DETAIL with single PK -->
    <changeSet id="110-create-order-detail" author="copilot">
        <createTable tableName="order_detail">
            <column name="order_detail_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_order_detail" nullable="false"/>
            </column>
            <column name="order_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="line_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="BIGINT"/>
            <column name="sku" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="product_name" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
            <column name="variant" type="VARCHAR(200)"/>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="discount_amount" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tax_amount" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="line_total" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- sequences (add once globally if not already present) -->
        <createSequence sequenceName="seq_order_detail_id" startValue="60000" incrementBy="1"/>

        <addForeignKeyConstraint
                baseTableName="order_detail" baseColumnNames="order_id"
                referencedTableName="orders" referencedColumnNames="order_id"
                constraintName="fk_detail_order"
                onDelete="CASCADE" onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="order_detail" baseColumnNames="product_id"
                referencedTableName="products" referencedColumnNames="product_id"
                constraintName="fk_detail_product"
                onDelete="SET NULL" onUpdate="RESTRICT"/>

        <!-- Keep line_number meaningful and unique per order -->
        <addUniqueConstraint tableName="order_detail"
                             columnNames="order_id, line_number"
                             constraintName="uk_order_detail_order_line"/>

        <createIndex indexName="idx_order_detail_order" tableName="order_detail">
            <column name="order_id"/>
        </createIndex>
        <createIndex indexName="idx_order_detail_sku" tableName="order_detail">
            <column name="sku"/>
        </createIndex>
        <createIndex indexName="idx_order_detail_product" tableName="order_detail">
            <column name="product_id"/>
        </createIndex>
    </changeSet>


    <changeSet id="120-create-payments" author="copilot">
        <createTable tableName="payments">
            <column name="payment_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_payments" nullable="false"/>
            </column>
            <column name="order_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="method" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_ref" type="VARCHAR(100)"/>
            <column name="auth_code" type="VARCHAR(40)"/>
            <column name="created_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="authorized_at_utc" type="TIMESTAMP"/>
            <column name="captured_at_utc" type="TIMESTAMP"/>
            <column name="failure_reason" type="VARCHAR(200)"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="payments" baseColumnNames="order_id"
                referencedTableName="orders" referencedColumnNames="order_id"
                constraintName="fk_payment_order"
                onDelete="CASCADE" onUpdate="RESTRICT"/>

        <createIndex indexName="idx_payments_order" tableName="payments">
            <column name="order_id"/>
        </createIndex>
        <createIndex indexName="idx_payments_status" tableName="payments">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="130-create-payment-refund" author="copilot">
        <createTable tableName="payment_refund">
            <column name="refund_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_payment_refund" nullable="false"/>
            </column>
            <column name="payment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(200)"/>
            <column name="refunded_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="payment_refund" baseColumnNames="payment_id"
                referencedTableName="payments" referencedColumnNames="payment_id"
                constraintName="fk_refund_payment"
                onDelete="CASCADE" onUpdate="RESTRICT"/>

    </changeSet>

    <changeSet id="140-create-shipments" author="copilot">
        <createTable tableName="shipments">
            <column name="shipment_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_shipments" nullable="false"/>
            </column>
            <column name="order_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="carrier" type="VARCHAR(40)"/>
            <column name="service" type="VARCHAR(40)"/>
            <column name="tracking_number" type="VARCHAR(60)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="READY">
                <constraints nullable="false"/>
            </column>
            <column name="shipped_at_utc" type="TIMESTAMP"/>
            <column name="delivered_at_utc" type="TIMESTAMP"/>
            <column name="created_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="shipments" baseColumnNames="order_id"
                referencedTableName="orders" referencedColumnNames="order_id"
                constraintName="fk_shipment_order"
                onDelete="CASCADE" onUpdate="RESTRICT"/>

        <createIndex indexName="idx_shipments_order" tableName="shipments">
            <column name="order_id"/>
        </createIndex>
        <createIndex indexName="idx_shipments_status" tableName="shipments">
            <column name="status"/>
        </createIndex>
    </changeSet>


    <!-- 150 - SHIPMENT ITEM with single PK and FK to order_detail_id -->
    <changeSet id="150-create-shipment-item" author="copilot">
        <createTable tableName="shipment_item">
            <column name="shipment_item_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_shipment_item" nullable="false"/>
            </column>
            <column name="shipment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="order_detail_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createSequence sequenceName="seq_shipment_item_id" startValue="70000" incrementBy="1"/>

        <addForeignKeyConstraint
                baseTableName="shipment_item" baseColumnNames="shipment_id"
                referencedTableName="shipments" referencedColumnNames="shipment_id"
                constraintName="fk_shipment_item_shipment"
                onDelete="CASCADE" onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
                baseTableName="shipment_item" baseColumnNames="order_detail_id"
                referencedTableName="order_detail" referencedColumnNames="order_detail_id"
                constraintName="fk_shipment_item_detail"
                onDelete="RESTRICT" onUpdate="RESTRICT"/>

        <createIndex indexName="idx_shipment_item_shipment" tableName="shipment_item">
            <column name="shipment_id"/>
        </createIndex>
        <createIndex indexName="idx_shipment_item_detail" tableName="shipment_item">
            <column name="order_detail_id"/>
        </createIndex>
    </changeSet>


